# Bloc de site Auto-Piece, a deposer dans /opt/caddy-sites/ sur le VPS
# (dossier monte dans le conteneur eprinters_caddy sur /etc/caddy/sites, importe
# par la derniere ligne du Caddyfile principal : import /etc/caddy/sites/*.caddy).
#
#   cp deploy/Caddyfile.example /opt/caddy-sites/10-autopiece.caddy
#   sed -i 's/autopiece.example.com/LE-DOMAINE-REEL/g' /opt/caddy-sites/10-autopiece.caddy
#   docker exec eprinters_caddy caddy reload --config /etc/caddy/Caddyfile
#
# Ne PAS y ajouter de bloc global entre accolades : les options globales (email
# ACME, trusted_proxies) sont deja definies dans le Caddyfile principal, et un
# second bloc global ferait echouer le chargement de toute la configuration —
# y compris le site eprinters.
#
# Le domaine est ecrit en clair ici, contrairement au site eprinters qui utilise
# {$DOMAIN} : cette variable appartient au conteneur Caddy et pointe deja sur
# l'autre application. En introduire une seconde imposerait de modifier la pile
# eprinters, ce que ce deploiement evite.

www.autopiece.example.com {
	redir https://autopiece.example.com{uri} permanent
}

autopiece.example.com {

	encode zstd gzip

	# Imports Excel et photos de pieces.
	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Tout passe par l'application. Contrairement au site eprinters, /static et
	# /media ne sont pas servis en direct par Caddy : ce conteneur n'a pas acces
	# aux volumes d'Auto-Piece, et lui en donner l'acces obligerait a modifier la
	# pile eprinters. Cote application, WhiteNoise sert les statiques (compresses,
	# avec en-tetes de cache) et Django sert les medias. C'est suffisant a cette
	# echelle ; si le trafic image devient lourd, monter /opt/autopiece/media dans
	# le conteneur Caddy et ajouter un handle_path /media/* ici.
	handle {
		reverse_proxy autopiece_web:8000 {
			header_up X-Real-IP {remote_host}
			health_uri /healthz/
			health_interval 30s
			health_timeout 5s
		}
	}

	log {
		output file /data/autopiece-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
