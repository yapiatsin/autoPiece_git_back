# Environnements virtuels et caches Python
env/
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets et bases locales : injectes a l'execution, jamais dans l'image
.env
.env.*
!.env.example
*.sqlite3
*.sqlite3-journal
db.sqlite3

# Fichiers generes / uploads : montes en volume sur le VPS
staticfiles/
media/

# Sauvegardes et exports : ils contiennent l'integralite des donnees clients.
# Sans ces lignes, un build lance sur le VPS (make rebuild-local) les embarque
# dans l'image, qui est ensuite publiee sur un registre de conteneurs.
backups/
data_export.json
*.sql
*.sql.gz
*.dump
*.tar.gz

# Git et outillage
.git/
.github/
.gitignore
.claude/
"How to use Claude"/

# Documentation et scripts de dev
*.md
!README.md
_cleanup_static.py
_fix_dash.py
dummy
EPSON*

# Divers OS
.DS_Store
Thumbs.db
