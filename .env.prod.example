# ============================================================================
# Modele de configuration PRODUCTION — a copier en /opt/autopiece/.env
#   cp .env.prod.example .env  puis remplir chaque valeur.
# Ce fichier ne doit JAMAIS etre commite avec de vraies valeurs.
# ============================================================================

# --- Django -----------------------------------------------------------------
# Generer une cle unique (ne pas reutiliser celle du poste de developpement) :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_LONGUE
DEBUG=False
LOG_LEVEL=INFO

# Domaines servis par l'application, separes par des virgules, sans schema.
DJANGO_ALLOWED_HOSTS=autopiece.example.com,www.autopiece.example.com
# Origines autorisees pour le CSRF, AVEC le schema https://
CSRF_TRUSTED_ORIGINS=https://autopiece.example.com,https://www.autopiece.example.com

# Cookies transmis uniquement en HTTPS. Passer a False seulement si le site
# est temporairement expose en HTTP simple, sinon la connexion echoue.
SECURE_COOKIES=True
# Activer HSTS (31536000 = 1 an) une fois le HTTPS confirme stable.
SECURE_HSTS_SECONDS=0

# --- Base de donnees --------------------------------------------------------
DB_ENGINE=postgresql
DB_NAME=autopiece
DB_USER=autopiece
DB_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT
DB_HOST=db
DB_PORT=5432

# --- URLs publiques ---------------------------------------------------------
PUBLIC_BASE_URL=https://autopiece.example.com
FRONTEND_URL=https://autopiece.example.com

# --- Messagerie -------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=

# --- Pusher (temps reel magasin) --------------------------------------------
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# --- GeniusPay (paiements) --------------------------------------------------
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_WEBHOOK_SECRET=

# --- Chatbot ----------------------------------------------------------------
CHATBOT_AI_API_KEY=

# --- Image Docker a deployer ------------------------------------------------
# Renseignee automatiquement par le workflow GitHub Actions.
WEB_IMAGE=ghcr.io/yapiatsin/autopiece_git_back:latest

# --- Compte administrateur cree au premier demarrage (optionnel) ------------
# Retirer ces lignes une fois le compte cree.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
