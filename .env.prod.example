# ============================================================================
# Modele de configuration PRODUCTION — a copier en /opt/autopiece/.env
#   cp .env.prod.example .env  puis remplir chaque valeur.
# Ce fichier ne doit JAMAIS etre commite avec de vraies valeurs.
# ============================================================================

# --- Django -----------------------------------------------------------------
# Generer une cle unique (ne pas reutiliser celle du poste de developpement) :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_LONGUE
DEBUG=False
LOG_LEVEL=INFO

# Domaines servis par l'application, separes par des virgules, sans schema.
DJANGO_ALLOWED_HOSTS=autopiece.example.com,www.autopiece.example.com
# Origines autorisees pour le CSRF, AVEC le schema https://
CSRF_TRUSTED_ORIGINS=https://autopiece.example.com,https://www.autopiece.example.com

# Cookies transmis uniquement en HTTPS. Passer a False seulement si le site
# est temporairement expose en HTTP simple, sinon la connexion echoue.
SECURE_COOKIES=True
# Activer HSTS (31536000 = 1 an) une fois le HTTPS confirme stable.
SECURE_HSTS_SECONDS=0

# Politique d'ouverture croisee. « same-origin », le defaut de Django, coupe
# window.opener et empeche la fenetre Google de renvoyer le jeton d'identite :
# la connexion Google resterait bloquee sur une page blanche.
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin-allow-popups

# --- Base de donnees --------------------------------------------------------
DB_ENGINE=postgresql
DB_NAME=autopiece
DB_USER=autopiece
DB_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT
DB_HOST=db
DB_PORT=5432

# --- URLs publiques ---------------------------------------------------------
PUBLIC_BASE_URL=https://autopiece.example.com
FRONTEND_URL=https://autopiece.example.com

# --- Messagerie -------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=

# --- Pusher (temps reel magasin) --------------------------------------------
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# --- GeniusPay (paiements) --------------------------------------------------
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
GENIUSPAY_WEBHOOK_SECRET=

# --- FNE (facture normalisée électronique DGI) ------------------------------
FNE_ENABLED=True
FNE_API_KEY=cle-api-production-espace-fne
FNE_BASE_URL=url-production-transmise-par-la-dgi
FNE_ETABLISSEMENT=
FNE_POINT_DE_VENTE=
FNE_CLIENT_TELEPHONE=
FNE_CLIENT_EMAIL=
FNE_TAXE_HORS_TVA=TVAD

# WhatsApp business (meme numero que le site e-com)
WHATSAPP_BUSINESS_NUMBER=2250787532210

# --- Connexion par compte Google --------------------------------------------
# Identifiant client OAuth 2.0 de type « Application Web », cree dans la console
# Google Cloud. Il est public (present dans le HTML) : ce n'est pas un secret.
# Origines JavaScript autorisees a declarer cote Google :
#   https://holding-projet.tech  et  http://localhost:8000 pour le developpement
# Laisser vide desactive proprement le bouton Google.
GOOGLE_OAUTH_CLIENT_ID=

# --- Chatbot ----------------------------------------------------------------
CHATBOT_AI_API_KEY=

# --- Reseau du Caddy deja en service sur le VPS ------------------------------
# Nom exact du reseau Docker auquel le conteneur Caddy est attache. Le trouver
# avec :  docker inspect eprinters_caddy --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
CADDY_NETWORK=

# --- Image Docker a deployer ------------------------------------------------
# Renseignee automatiquement par le workflow GitHub Actions.
WEB_IMAGE=ghcr.io/yapiatsin/autopiece_git_back:latest

# --- Compte administrateur cree au premier demarrage (optionnel) ------------
# Retirer ces lignes une fois le compte cree.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
